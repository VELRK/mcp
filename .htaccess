Options -MultiViews
DirectoryIndex index.php index.html

RewriteEngine On
# Do not set RewriteBase / — that sends /mcp/ rewrites to htdocs root.
# Relative [R=301] on Windows Apache becomes C:/xampp/htdocs/... (403 Forbidden).
# Compute the URL prefix (/ or /mcp/) and use it for every external redirect.
RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
RewriteRule ^(.*)$ - [E=APP_BASE:%1]

# Browser: /index.php/admin/login → /admin/login (one root index.php only)
RewriteCond %{THE_REQUEST} \s/+index\.php/([^\s?]*) [NC]
RewriteRule ^index\.php/(.*)$ %{ENV:APP_BASE}$1 [R=301,L,QSA]

# Pass Authorization to PHP (Apache often strips it otherwise → JWT/royalty fail)
RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# ── CORS ──────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Auth-Token, X-Requested-With, X-Session-ID"
</IfModule>

RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^ - [R=200,L]

# Service worker
RewriteRule ^firebase-messaging-sw\.js$ firebase-messaging-sw.php [L]
<Files "firebase-messaging-sw.php">
    Header set Content-Type "application/javascript"
    Header set Service-Worker-Allowed "/"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</Files>

# Legacy path redirects (APP_BASE keeps these on /mcp/ locally and / in production)
RewriteRule ^ilf/frontend/assets/(.*)$ %{ENV:APP_BASE}frontend/assets/$1 [R=301,L]
RewriteRule ^ilf/assets/(.*)$ %{ENV:APP_BASE}assets/$1 [R=301,L]
RewriteRule ^ecomm/(.*)$ %{ENV:APP_BASE}$1 [R=301,L]
RewriteRule ^deal/assets/(.*)$ %{ENV:APP_BASE}assets/$1 [R=301,L]
RewriteRule ^deal/(.*)$ %{ENV:APP_BASE}$1 [R=301,L]
# Legacy /shopkart/... URLs
# POST must NOT use external 301 (browsers turn POST→GET and drop the body → "settings not saved").
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$ [NC]
RewriteRule ^shopkart/?$ index.php?/admin [L,QSA]
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$ [NC]
RewriteRule ^shopkart/(.+)$ index.php?/admin/$1 [L,QSA]
# GET: send browsers to /admin/...
RewriteRule ^shopkart/?$ %{ENV:APP_BASE}admin [R=301,L]
RewriteRule ^shopkart/(.+)$ %{ENV:APP_BASE}admin/$1 [R=301,L]

<Files "frontend/index.html">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</Files>

# Real files/folders under static trees → Apache (missing file = real 404)
RewriteRule ^(frontend|assets|images|css|js|fonts|webfonts|uploads)/ - [L]

# Missing hashed frontend assets must NOT become SPA HTML (breaks module MIME)
RewriteCond %{REQUEST_URI} /frontend/assets/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ - [R=404,L]

# Existing files anywhere (e.g. robots.txt) → Apache
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# ── Single CodeIgniter front controller (landing + admin + APIs) ──
# Query-string form works on most cPanel hosts; CI reads REQUEST_URI.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?/$1 [L,QSA]
