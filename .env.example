# Copy to .env and fill only local/platform secrets.
# WhatsApp Cloud credentials are stored in the database
# (Admin → Settings / per-vendor WhatsApp accounts). Do not duplicate them here.

# ── Meta Business Agent Platform ──────────────────────────────
META_BA_ENABLED=0
META_BA_API_BASE=https://api.facebook.com
META_BA_API_VERSION=2.0.0
# Optional platform-only fallback token (your own Meta numbers).
# SaaS shops do NOT use this — each vendor token lives in vendor_whatsapp_accounts.access_token
# after Meta / WhatsApp connect. Do not put tenant tokens here.
META_BA_SYSTEM_USER_TOKEN=
# Optional platform-only BA billable account (your own Billing Hub account).
# SaaS: store per vendor in vendor_whatsapp_accounts.ba_account_id instead.
META_BA_BILLABLE_ACCOUNT_ID=
# Shared secret Meta Agent connectors use when calling this app
META_BA_CONNECTOR_API_KEY=
# Public HTTPS base for connector tools (production shop)
META_BA_CONNECTOR_BASE_URL=https://talkaipilot.com
# Default audience: ALLOWLISTED_ONLY | EVERYONE
META_BA_DEFAULT_AUDIENCE=ALLOWLISTED_ONLY
META_BA_HANDOFF_MESSAGE=A human teammate will continue this chat shortly.

# Optional app secrets (only if you do not set them elsewhere)
# JWT_SECRET=
# CI_ENV=production
