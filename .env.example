# Copy this file to .env in the deployment server and replace values with real credentials.
# This project reads these values at runtime via getenv().

WHATSAPP_PROVIDER=syncr
WHATSAPP_API_KEY=replace_with_syncr_api_key
WHATSAPP_API_URL=https://waadmin.syncr.in/v1/message/send-message
WHATSAPP_FROM_NUMBER=
WHATSAPP_DEVELOPMENT_MODE=false
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEST_FORCE_PHONE=

WA_CLOUD_ENABLED=1
WA_CLOUD_ACCESS_TOKEN=replace_with_meta_system_user_token
WA_CLOUD_PHONE_NUMBER_ID=replace_with_whatsapp_phone_number_id
WA_CLOUD_WABA_ID=replace_with_waba_id
WA_CLOUD_APP_SECRET=replace_with_meta_app_secret
WA_CLOUD_APP_ID=replace_with_meta_app_id
WA_CLOUD_CONFIG_ID=replace_with_meta_config_id
WA_CLOUD_VERIFY_TOKEN=replace_with_meta_verify_token
WA_CLOUD_API_VERSION=v21.0
WA_CLOUD_REFRESH_TOKEN=
WA_CLOUD_TOKEN_EXPIRES=
WA_CLOUD_FB_USER_ID=
WA_CLOUD_BUSINESS_ID=
WA_CLOUD_DISPLAY_PHONE=

# Legacy external MCP / local AI reply paths are disabled when Meta BA owns chat.
WA_MCP_ENABLED=0
WA_MCP_URL=
WA_MCP_TOKEN=
WA_MCP_TIMEOUT=12

# ── Meta Business Agent Platform ──────────────────────────────
META_BA_ENABLED=0
META_BA_API_BASE=https://api.facebook.com
META_BA_API_VERSION=2.0.0
# System user / BISU token with whatsapp_business_messaging + whatsapp_business_management
META_BA_SYSTEM_USER_TOKEN=
# Shared secret Meta Agent connectors use when calling this app
META_BA_CONNECTOR_API_KEY=
# Public HTTPS base for connector tools (production shop)
META_BA_CONNECTOR_BASE_URL=https://talkaipilot.com
# Default audience: ALLOWLISTED_ONLY | EVERYONE
META_BA_DEFAULT_AUDIENCE=ALLOWLISTED_ONLY
META_BA_HANDOFF_MESSAGE=A human teammate will continue this chat shortly.

# Optional legacy aliases supported by the app
SYNCR_PROVIDER=syncr
SYNCR_API_KEY=replace_with_syncr_api_key
SYNCR_API_URL=https://waadmin.syncr.in/v1/message/send-message
SYNCR_DEVELOPMENT_MODE=false

MCP_ENABLED=0
MCP_URL=
MCP_TOKEN=

JWT_SECRET=
CI_ENV=production

# Django/Node style compatibility (only if your host exposes them)
# META_APP_ID=
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
